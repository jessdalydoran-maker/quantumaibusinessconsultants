# AI chat receptionist — required for the chat widget to respond
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used by the AI receptionist (defaults to claude-sonnet-5)
CHAT_MODEL=claude-sonnet-5

# Contact form + chat lead capture emails — required for /contact and lead capture to send
# Get a key at https://resend.com/
RESEND_API_KEY=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=

# Discovery call booking link, shown as the fallback link. Defaults to the real
# Cal.com booking page (see src/lib/site.ts) if unset.
NEXT_PUBLIC_BOOKING_URL=

# Cal.com — required for the AI receptionist to check real availability and book
# discovery calls directly in the chat widget. Personal API key from
# Cal.com > Settings > Developer > API Keys. NEVER commit your real key here —
# put it in .env.local (gitignored) or your host's environment variables instead.
CAL_API_KEY=

# Optional: override the Cal.com API base URL (defaults to https://api.cal.eu/v2,
# since this account is EU-hosted; use https://api.cal.com/v2 for a global account).
CAL_API_BASE=

# Quantum CRM (/app) — Supabase project settings, from
# Supabase dashboard > Project Settings > API.
# NEXT_PUBLIC_* values are safe to expose to the browser (the anon key only
# works within RLS policies). NEVER put the service role key in a NEXT_PUBLIC_*
# variable or commit a real value here — it bypasses RLS entirely and must
# only ever be read server-side. Put real values in .env.local (gitignored)
# or your host's environment variables instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Unified inbox (/app/inbox) — email channel. See docs/inbox-setup.md for the
# full setup (Resend domain + webhook + DNS).
INBOUND_EMAIL_DOMAIN=
RESEND_WEBHOOK_SECRET=

# Separate Resend account/API key from RESEND_API_KEY above — the inbound
# domain (INBOUND_EMAIL_DOMAIN) is verified on a different Resend account,
# so inbox send/receive uses its own key rather than forcing both features
# onto one paid account.
INBOX_RESEND_API_KEY=

# SMS + WhatsApp channels (/app/inbox) — one Twilio account for the whole
# platform; each client account gets its own Twilio phone number stored on
# accounts.twilio_phone_number (set per-account at /app/settings/sms).
# From Twilio Console > Account > API keys & tokens.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Conversation AI (/app/settings/ai) — reuses ANTHROPIC_API_KEY (already set
# for the marketing site's AI receptionist). Optional: override the model
# used for inbox auto-reply/drafting specifically (defaults to claude-sonnet-5).
CONVERSATION_AI_MODEL=claude-sonnet-5

# Broadcast email campaigns (/app/campaigns) — reuses INBOX_RESEND_API_KEY and
# INBOUND_EMAIL_DOMAIN above for sending (campaigns@<that domain>).
# Secret used to sign per-contact unsubscribe links — any long random string,
# generate once and never change it (changing it invalidates every
# already-sent unsubscribe link).
UNSUBSCRIBE_SECRET=
# Separate webhook + signing secret from RESEND_WEBHOOK_SECRET (Prompt 6) —
# subscribe this one to email.bounced/opened/clicked for campaign tracking.
RESEND_CAMPAIGN_WEBHOOK_SECRET=
# Protects /api/cron/send-scheduled-campaigns from being triggered by anyone
# who finds the URL — Vercel automatically sends this as a Bearer token on
# cron-triggered requests when set. Any long random string.
CRON_SECRET=

# Voice AI (/app/settings/voice, /app/calls) — Retell AI. From Retell
# dashboard > API Keys. See docs/build-log.md (Prompt 9) for why Retell over
# Vapi, and for the flagged, unverified webhook-signature implementation —
# test against a real Retell webhook before relying on it.
RETELL_API_KEY=

# Contacts — Lead Finder (/app/contacts/find) — Google Places API (New).
# Enable "Places API (New)" in Google Cloud Console for this project, and
# restrict the key to that API. Server-side only, never exposed to the
# browser. Note: requesting phone/website fields (which this feature does)
# is billed on Google's higher "Places API (New) - Enterprise" SKU, not the
# base tier — check current pricing before heavy use.
GOOGLE_PLACES_API_KEY=
