# AI chat receptionist — required for the chat widget to respond
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used by the AI receptionist (defaults to claude-sonnet-5)
CHAT_MODEL=claude-sonnet-5

# Contact form + chat lead capture emails — required for /contact and lead capture to send
# Get a key at https://resend.com/
RESEND_API_KEY=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=

# Discovery call booking link, shown as the fallback link. Defaults to the real
# Cal.com booking page (see src/lib/site.ts) if unset.
NEXT_PUBLIC_BOOKING_URL=

# Cal.com — required for the AI receptionist to check real availability and book
# discovery calls directly in the chat widget. Personal API key from
# Cal.com > Settings > Developer > API Keys. NEVER commit your real key here —
# put it in .env.local (gitignored) or your host's environment variables instead.
CAL_API_KEY=

# Optional: override the Cal.com API base URL (defaults to https://api.cal.eu/v2,
# since this account is EU-hosted; use https://api.cal.com/v2 for a global account).
CAL_API_BASE=
